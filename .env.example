# Copy to .env in the repository root:
#
#   cp .env.example .env
#
# .gitignore excludes .env, so real values never reach the repository. Both
# docker-compose (via env_file) and local runs read it. In Kubernetes these come from a
# ConfigMap for the plain values and a Secret for the three marked below.
#
# Precedence trap: anything set in the compose file's `environment:` block overrides the
# same key here. That block deliberately holds non-secrets only.

# --- secrets -----------------------------------------------------------------
# Shared with OpenWebUI's Integrations connection. Leave empty to disable auth in dev.
HIVE_AUTH_TOKEN=

# Signs download links. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty and each start generates a fresh key, which invalidates every link handed
# out before the restart. With more than one replica it must be set, or a link signed by
# one pod fails on another.
HIVE_SIGNING_KEY=

# OpenWebUI: Settings -> Admin -> System -> General -> API Keys (enable),
# then Settings -> Account -> API Keys -> Generate. Starts with sk-.
# Without it, generated documents come back as download links instead of files in the chat.
HIVE_OWUI_API_KEY=

# --- OpenWebUI ---------------------------------------------------------------
# Which value is right depends on where OpenWebUI runs. This is the setting people get
# wrong most often, because both sides connect *server to server*: a URL that works in
# your browser usually does not work from inside a container.
#
#   started via `make owui` (same compose network)  -> http://openwebui:8080
#   OpenWebUI in its own container, port 3000       -> http://host.docker.internal:3000
#   OpenWebUI directly on the host, port 3000       -> http://host.docker.internal:3000
#   HiveMCP not in a container at all               -> http://localhost:3000
#
# Verify from inside the HiveMCP container:
#   docker compose -f deploy/docker-compose.yml exec hivemcp \
#     python -c "import urllib.request;print(urllib.request.urlopen('$HIVE_OWUI_URL/health').status)"
HIVE_OWUI_URL=http://openwebui:8080

# --- server ------------------------------------------------------------------
HIVE_ENVIRONMENT=dev
HIVE_LOG_LEVEL=INFO
HIVE_PUBLIC_URL=http://localhost:8080
HIVE_DATA_DIR=./data
# The MCP SDK auto-enables DNS rebinding protection unless it believes it is bound
# to a non-loopback address; 127.0.0.1 makes a container reject Host: hivemcp:8080.
HIVE_MCP_HOST=0.0.0.0

# --- limits ------------------------------------------------------------------
HIVE_MAX_UPLOAD_MB=50
HIVE_MAX_RENDER_CONCURRENCY=4
HIVE_TMP_TTL_MINUTES=60

# --- brief mode --------------------------------------------------------------
# On: a tool can be given a short 'brief' instead of a full spec, and HiveMCP asks the
# model the user selected in the chat to write the spec. It reaches that model through
# OpenWebUI's own chat-completions API, so HIVE_OWUI_URL and HIVE_OWUI_API_KEY above are
# required and no second LLM endpoint or key exists.
HIVE_LLM_ENABLED=false

# Only used when the selected model cannot be determined (for example when the service
# API key cannot read the chat). Empty on purpose: failing with a clear message beats
# quietly answering with a different model than the user picked.
HIVE_LLM_FALLBACK_MODEL=

HIVE_LLM_TIMEOUT_SECONDS=120
HIVE_LLM_MAX_REPAIR_ATTEMPTS=1
HIVE_LLM_MAX_OUTPUT_TOKENS=8000
