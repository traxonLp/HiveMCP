# Copy to .env in the repository root:
#
#   cp .env.example .env      (or: make env)
#
# .gitignore excludes .env, so real values never reach the repository.
#
# Precedence trap: anything set in the compose file's `environment:` block overrides the
# same key here. That block deliberately holds non-secrets only.
#
# There is no API key and no shared secret in this file any more. Callers authenticate
# with their own OpenWebUI session token, which HiveMCP validates against HIVE_OWUI_URL
# and then reuses on their behalf, so generated documents belong to the right person.
# Set the HiveMCP connection in OpenWebUI to authentication type "Session".

# --- required -----------------------------------------------------------------
# Where OpenWebUI is, as reachable *from this container*. Session tokens are validated
# here and files are uploaded here. Without it nothing can authenticate at all.
#
#   started via `make owui` (same compose network)  -> http://openwebui:8080
#   OpenWebUI in its own container, port 3000       -> http://host.docker.internal:3000
#   OpenWebUI directly on the host, port 3000       -> http://host.docker.internal:3000
#   HiveMCP not in a container at all               -> http://localhost:3000
HIVE_OWUI_URL=http://openwebui:8080

# --- secret ---------------------------------------------------------------------
# Signs download links. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Left empty, each start generates a fresh key and invalidates every link handed out
# before the restart. With more than one replica it must be set explicitly, or a link
# signed by one pod fails on another.
HIVE_SIGNING_KEY=

# --- server ---------------------------------------------------------------------
HIVE_ENVIRONMENT=dev
HIVE_LOG_LEVEL=INFO
HIVE_PUBLIC_URL=http://localhost:8080
HIVE_DATA_DIR=./data
# The shared template pool. Defaults to $HIVE_DATA_DIR/templates; point it at its own
# small volume in Kubernetes so the curated templates survive clearing the artifact
# volume. See deploy/k8s/templates-pvc.yaml.
# HIVE_TEMPLATES_DIR=./data/templates
# The MCP SDK auto-enables DNS rebinding protection unless it believes it is bound to a
# non-loopback address; 127.0.0.1 makes a container reject Host: hivemcp:8080.
HIVE_MCP_HOST=0.0.0.0
# How long a validated session is trusted without re-checking against OpenWebUI.
HIVE_SESSION_CACHE_TTL_SECONDS=60

# --- limits ---------------------------------------------------------------------
HIVE_MAX_UPLOAD_MB=50
HIVE_MAX_RENDER_CONCURRENCY=4
HIVE_TMP_TTL_MINUTES=60

# --- brief mode -----------------------------------------------------------------
# On: a tool can be given a short 'brief' instead of a full spec, and HiveMCP asks the
# model the user selected in the chat to write the spec, using that user's own session.
# Requires HIVE_OWUI_URL above and the X-Hive-Chat-Id header on the connection.
HIVE_LLM_ENABLED=false

# Only used when the selected model cannot be determined. Empty on purpose: failing with
# a clear message beats quietly answering with a different model than the user picked.
HIVE_LLM_FALLBACK_MODEL=

HIVE_LLM_TIMEOUT_SECONDS=120
HIVE_LLM_MAX_REPAIR_ATTEMPTS=1
HIVE_LLM_MAX_OUTPUT_TOKENS=8000
